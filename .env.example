# --- Supabase (Project settings > API) ---
# Sans ces variables, l'app utilise un stockage local JSON (.data/db.json) : développement uniquement.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé service_role : utilisée UNIQUEMENT côté serveur (routes API). Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket Supabase Storage (public) pour les photos de décoration
SUPABASE_STORAGE_BUCKET=decorations

# --- Backoffice ---
# Mot de passe lecture/écriture
ADMIN_PASSWORD=
# Mot de passe lecture seule (optionnel)
ADMIN_READONLY_PASSWORD=
# Secret de signature des sessions admin (32+ caractères aléatoires)
ADMIN_SESSION_SECRET=

# --- Public ---
NEXT_PUBLIC_SITE_URL=https://votechamas.fr
# Lien du réseau social où le tirage sera diffusé en direct
NEXT_PUBLIC_SOCIAL_URL=
NEXT_PUBLIC_SOCIAL_LABEL=Instagram
# Vidéo optionnelle affichée au-dessus de la question 4 (comme dans le Typeform)
NEXT_PUBLIC_VOTE_VIDEO_URL=
