        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/steev/AppData/Roaming/Python/Python312/Scripts/graphify.exe\" hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Users/steev/AppData/Roaming/Python/Python312/Scripts/graphify.exe\" hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}